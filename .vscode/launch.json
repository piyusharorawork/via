{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "cli",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/server-workspace/cli",
      "cwd": "${workspaceFolder}/server-workspace",
      "args": [
        "extract-clip",
        "-v",
        "https://test-v1.blr1.digitaloceanspaces.com/temp/effbb04d-b2d0-4096-a6df-244f8d5d1dff/5-sec.mp4",
        "-o",
        "${workspaceFolder}/assets/temp/75-106.mp4",
        "-s",
        "75",
        "-e",
        "106",
        "-f",
        "25"
      ],
      "env": {}
    },
    {
      "name": "server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/server-workspace/server",
      "cwd": "${workspaceFolder}/server-workspace"
    },
    {
      "name": "extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extension"],
      "outFiles": ["${workspaceFolder}/extension/out/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      "name": "quick-reel-next",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/web-workspace/apps/quick-reel-next",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    }
  ]
}
